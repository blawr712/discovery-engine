{
    "application": {
        "data_source": "yfinance",
        "log_level": "INFO",
        "weekly_refresh": true,
        "universe_directory": "data/raw/universe"
    },

    "directories": {
        "output_directory": "data/exports",
        "cache_directory": "data/cache",
        "run_directory": "data/runs"
    },

    "runtime": {
        "save_raw_data": true,
        "allow_large_cap_watchlist": true,
        "max_concurrent_downloads": 5
    },

    "cache": {
        "enabled": true,
        "metadata_ttl_hours": 168,
        "price_history_ttl_hours": 24
    },

    "retry": {
        "enabled": true,
        "max_attempts": 3,
        "base_delay_seconds": 0.5,
        "max_delay_seconds": 8,
        "jitter_seconds": 0.25
    },

    "run_state": {
        "resume_enabled": true,
        "retry_errors_on_resume": true
    }
}
