{
    "application": {
        "data_source": "yfinance",
        "log_level": "INFO",
        "weekly_refresh": true,
        "universe_directory": "data/raw/universe"
    },

    "directories": {
        "output_directory": "data/exports",
        "cache_directory": "data/cache",
        "run_directory": "data/runs"
    },

    "runtime": {
        "save_raw_data": true,
        "allow_large_cap_watchlist": true,
        "max_concurrent_downloads": 5,
        "metadata_concurrent_downloads": 2,
        "price_concurrent_downloads": 5
    },

    "cache": {
        "enabled": true,
        "metadata_version": "v0.3-fundamentals-2",
        "metadata_ttl_hours": 168,
        "price_history_ttl_hours": 24
    },

    "retry": {
        "enabled": true,
        "max_attempts": 3,
        "base_delay_seconds": 0.5,
        "max_delay_seconds": 8,
        "jitter_seconds": 0.25
    },

    "rate_limit": {
        "enabled": true,
        "metadata_interval_seconds": 1.0,
        "price_interval_seconds": 0.2,
        "cooldown_seconds": 300,
        "max_cooldown_events": 3
    },

    "run_state": {
        "resume_enabled": true,
        "retry_errors_on_resume": true
    },

    "research": {
        "ai_synthesis_enabled": false,
        "default_top_candidates": 10,
        "prompt_version": "v0.3-research-1",
        "cache_directory": "data/cache/research",
        "evidence": {
            "cache_directory": "data/cache/evidence",
            "cache_ttl_hours": 168,
            "maximum_documents_per_company": 5,
            "maximum_age_days": 730,
            "allowed_domains": ["sec.gov"],
            "sec_forms": ["10-K", "10-Q", "8-K", "20-F", "40-F", "6-K"]
        }
    }
}
